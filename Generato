#!/bin/bash

# Generato Script (c) 2023 Liwei Ji
# A script to process *.wl files and generate corresponding output files.

[[ "$QUIET" != "1" ]] && echo "Generato (c) 2023 Liwei Ji"

# Function to display help message
show_help() {
  echo "USAGE:"
  echo "  Generato <file1.wl> [file2.wl] ..."
  echo
  echo "DESCRIPTION:"
  echo "  Processes the specified Wolfram Language (*.wl) files using wolframscript."
  echo "  Each script writes its own output file. Every script is run; the exit"
  echo "  status is non-zero if any of them failed, and a failed script leaves no"
  echo "  output file."
  echo
  echo "EXAMPLES:"
  echo "  Generato C3GH_set_profile_ADM.wl"
  echo "  Generato file1.wl file2.wl"
}

# Check for help flag or no arguments
if [[ "$1" == "-h" || "$1" == "--help" || -z "$1" ]]; then
  show_help
  exit 0
fi

# Check if wolframscript is installed
if ! command -v wolframscript &> /dev/null; then
  echo "Error: 'wolframscript' is not installed or not in PATH."
  exit 1
fi

# The driver, and the scripts themselves, are found through GENERATO
if [[ ! -f "$GENERATO/src/Driver.wl" ]]; then
  echo "Error: GENERATO is not set to the Generato repository ('$GENERATO/src/Driver.wl' not found)."
  exit 1
fi

# Process each file given as an argument. Each script runs in its own kernel,
# so one that fails does not stop the others.
total=0
failed=()
for input_file in "$@"; do
  total=$((total + 1))

  # Ensure the file exists
  if [[ ! -f "$input_file" ]]; then
    echo "Error: File '$input_file' does not exist."
    failed+=("$input_file")
    continue
  fi

  # Run the script through the driver, which catches every abnormal ending
  # and is the only place that sets a non-zero exit status
  [[ "$QUIET" != "1" ]] && echo "Processing '$input_file'..."
  if ! wolframscript -script "$GENERATO/src/Driver.wl" "$input_file"; then
    echo "Error: Failed to process '$input_file'."
    failed+=("$input_file")
  fi

  [[ "$QUIET" != "1" ]] && echo
done

if [[ ${#failed[@]} -eq 0 ]]; then
  [[ "$QUIET" != "1" ]] && echo "DONE."
  exit 0
fi

# Say which scripts failed. A script that did not fail wrote its file.
written=$((total - ${#failed[@]}))
scripts_word="scripts"
[[ $total -eq 1 ]] && scripts_word="script"
files_word="files"
[[ $written -eq 1 ]] && files_word="file"
echo "Generato: ${#failed[@]} of $total $scripts_word failed, $written $files_word written."
for input_file in "${failed[@]}"; do
  echo "  failed: $input_file"
done
exit 1
